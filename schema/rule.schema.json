{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title","id","status","description","author","date",
               "tags","logsource","detection","falsepositives","level"],
  "properties": {
    "title": {"type": "string", "maxLength": 100},
    "id": {"type": "string",
           "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "status": {"enum": ["experimental","test","stable","deprecated"]},
    "level": {"enum": ["informational","low","medium","high","critical"]},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "falsepositives": {"type": "array", "minItems": 1},
    "tags": {"type": "array", "allOf": [
      {"contains": {"type": "string", "pattern": "^attack\\.t\\d{4}(\\.\\d{3})?$"}},
      {"contains": {"type": "string", "pattern": "^attack\\.[a-z_-]+$"}}
    ]}
  }
}